# Configuracion LOCAL (Spring Boot ejecutado con mvnw / IDE).
# Copiar como .env si se desea conservar una referencia local.
#
# IMPORTANTE: Spring Boot NO lee automaticamente el archivo .env.
# Exporte las variables en la terminal antes de ejecutar:
#   $env:JWT_SECRET="..."
# o configurelas en su IDE.
#
# .env NO debe versionarse.

SERVER_PORT=8083

# MySQL local (Laragon, XAMPP, MySQL Installer, etc.)
DB_URL=jdbc:mysql://localhost:3306/sonidovivo_productos?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=
JPA_DDL_AUTO=update

# Debe ser EXACTAMENTE el mismo secreto que usa usuario-service.
# Minimo 32 bytes. No versionar el valor real.
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-bytes-compartido-con-usuario-service

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173
CATALOGO_CARGA_INICIAL=true
