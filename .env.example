# Copiar este archivo como .env y completar los valores.
# .env NO debe versionarse.

# --- MySQL (contenedor de docker compose) ---
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-root
MYSQL_DATABASE=sonidovivo_productos

# Usuario de aplicacion creado por la imagen de MySQL.
# No usar "root" aqui: la imagen oficial no permite MYSQL_USER=root.
DB_USERNAME=sonidovivo
DB_PASSWORD=cambiar-esta-clave-de-aplicacion

# Puertos publicados en el host
MYSQL_PORT=3306
APP_PORT=8083

# --- JWT ---
# Debe ser EXACTAMENTE el mismo secreto que usa autenticacion-service.
# Minimo 32 bytes. No versionar el valor real.
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-bytes-compartido-con-autenticacion

# --- Aplicacion ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173
CATALOGO_CARGA_INICIAL=true
JPA_DDL_AUTO=update
