# Copiar a .env.docker y completar antes de ejecutar.
# No subir .env.docker a GitHub.

# JWT_SECRET debe coincidir EXACTAMENTE con el secreto que actualmente firma
# los JWT en usuario-service. En el ZIP recibido ese secreto esta escrito
# directamente en SecurityConfig.java; por seguridad, migrarlo a variable
# de entorno antes de desplegar en AWS.
JWT_SECRET=REEMPLAZAR_POR_SECRETO_COMPARTIDO_DE_32_BYTES_O_MAS

# Bases de datos: contrasenas independientes
MYSQL_ROOT_PASSWORD=CAMBIAR_CLAVE_ROOT_PRODUCTOS
PRODUCTOS_DB_USER=sonidovivo_productos_app
PRODUCTOS_DB_PASSWORD=CAMBIAR_CLAVE_PRODUCTOS

PEDIDOS_DB_ROOT_PASSWORD=CAMBIAR_CLAVE_ROOT_PEDIDOS
PEDIDOS_DB_USER=sonidovivo_pedidos_app
PEDIDOS_DB_PASSWORD=CAMBIAR_CLAVE_PEDIDOS

USUARIOS_DB_ROOT_PASSWORD=CAMBIAR_CLAVE_ROOT_USUARIOS
USUARIOS_DB_USER=sonidovivo_usuarios_app
USUARIOS_DB_PASSWORD=CAMBIAR_CLAVE_USUARIOS

# Frontend React autorizado por CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# Administrador inicial de usuario-service (creacion idempotente al arrancar).
# Se crea solo si no existe un usuario con ADMIN_INICIAL_CORREO; nunca se
# sobrescribe la contrasena de un usuario existente.
# En produccion: definir una contrasena robusta y ADMIN_INICIAL_ENABLED=false
# despues de la primera creacion.
# Nota: estas variables se leen del entorno del proceso usuario-service. En el
# compose de este repositorio se usan los valores por defecto de
# application.properties; para sobreescribirlos en Docker hay que declararlos
# en el bloque environment de usuario-service en compose.yaml.
ADMIN_INICIAL_ENABLED=true
ADMIN_INICIAL_CORREO=admin@duocuc.cl
ADMIN_INICIAL_PASSWORD=CAMBIAR_CLAVE_ADMIN_INICIAL
ADMIN_INICIAL_NOMBRE=Administrador
ADMIN_INICIAL_APELLIDO=Sonido Vivo
ADMIN_INICIAL_RUN=11111111-1
ADMIN_INICIAL_FECHA_NACIMIENTO=1990-01-01
ADMIN_INICIAL_DIRECCION=Sin direccion registrada
